# Mermail Escrow Agent — environment template
# Copy to .env and fill in. Never commit the filled-in .env.

# Required: workspace API key from Mermail Settings → API Keys.
# Used by simulate_inbox.py and check_status.py (mailbox-draft path).
# Note: API keys CANNOT authorise PayBox — PayBox requires full-profile OAuth.
MERMAIL_API_KEY=sk-proj-your-key-here

# Optional: override the MCP URL for testing against staging.
# MERMAIL_MCP_URL=https://console-staging.mermail.app/mcp

# Optional: deal-record storage path (defaults to /tmp/deal-<deal_id>.json).
# ESCROW_DEAL_DIR=/tmp
